Options -MultiViews
DirectoryIndex out/index.html index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

  # 2. Admin Portal & Shortcuts (Direct mapping to standalone admin CMS)
  RewriteRule ^(adminlogin|admin-login|admin/login|login)/?$ /admin/ [L,R=301]
  RewriteRule ^admin$ /admin/ [L,R=301]
  RewriteRule ^admin/$ public/admin/index.html [L]
  RewriteRule ^admin/index\.html$ public/admin/index.html [L]
  RewriteRule ^admin/admin\.css$ public/admin/admin.css [L]
  RewriteRule ^admin/admin\.js$ public/admin/admin.js [L]
  RewriteRule ^admin/(.*)$ public/admin/$1 [L]

  # 3. Direct API access (PHP scripts)
  RewriteRule ^api/(.*)$ public/api/$1 [L,QSA]

  # 4. Media Uploads
  RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]

  # 5. Next.js Static Assets (_next)
  RewriteRule ^_next/(.*)$ out/_next/$1 [L]

  # 6. Static files that exist directly in out/
  RewriteCond %{DOCUMENT_ROOT}/out%{REQUEST_URI} -f
  RewriteRule ^(.*)$ out/$1 [L]

  # 7. HTML pages (e.g. /about/ -> out/about/index.html or out/about.html)
  RewriteCond %{DOCUMENT_ROOT}/out%{REQUEST_URI}/index.html -f
  RewriteRule ^(.*)/$ out/$1/index.html [L]

  RewriteCond %{DOCUMENT_ROOT}/out%{REQUEST_URI}.html -f
  RewriteRule ^(.*)$ out/$1.html [L]

  # 8. Root Homepage
  RewriteRule ^$ out/index.html [L]
</IfModule>

# Fallback 404
ErrorDocument 404 /out/404.html

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
