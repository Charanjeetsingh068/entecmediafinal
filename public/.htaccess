Options -MultiViews
DirectoryIndex index.html

RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

# Legacy URL redirects
RewriteRule ^projects/?$ /portfolio/ [L,R=301]
RewriteRule ^projects/(.+?)/?$ /portfolio/$1/ [L,R=301]
RewriteRule ^about-us/?$ /about/ [L,R=301]
RewriteRule ^contact-us/?$ /contact/ [L,R=301]
# The data deletion steps now live in the Privacy Policy
RewriteRule ^data-deletion/?$ /privacy-policy/#delete-your-data [L,R=301,NE]
RewriteRule ^services/branding/?$ /services/graphic-design/ [L,R=301]
RewriteRule ^services/brand-identity/?$ /services/graphic-design/ [L,R=301]
RewriteRule ^services/web-engineering/?$ /services/website-development/ [L,R=301]
RewriteRule ^services/uiux-design/?$ /services/ui-ux-design/ [L,R=301]
RewriteRule ^services/ecommerce/?$ /services/website-development/ [L,R=301]
RewriteRule ^services/digital-growth/?$ /services/digital-marketing/ [L,R=301]
RewriteRule ^services/motion-media/?$ /services/graphic-design/ [L,R=301]

# Leave the PHP blog CMS and the form mail API alone
RewriteRule ^blog-cms/ - [L]
RewriteRule ^api/ - [L]

# Mail settings must never be served directly
<Files "mail-config.php">
  Require all denied
</Files>

# Add trailing slash to page URLs (e.g. /about -> /about/)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]{1,5}|/)$
RewriteRule ^(.*)$ /$1/ [L,R=301]

ErrorDocument 404 /404.html

# Serve self-hosted fonts with the right type (some shared hosts don't know woff2)
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml
</IfModule>
